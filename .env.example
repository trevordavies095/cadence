# Optional overrides for docker-compose (copy to .env)

# Local API (non-compose) — host port 5433 maps to Postgres in compose
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ai_coach

# API CORS origin for browser calls (compose default is fine for local UI)
# CORS_ORIGIN=http://localhost:3001

# Wrapping key for AES-GCM encryption of Tempo + Anthropic API keys at rest.
# Use a long random string (or base64). Required for saving connection settings.
# Generate e.g.: openssl rand -base64 32
DATA_PROTECTION_SECRET_KEY=change-me-local-dev-only-not-for-prod

# Dev-only: fix "now" for ISO week resolution (ignored when NODE_ENV=production)
# DEV_CLOCK_NOW=2026-10-21T15:00:00.000Z
# Demo instance: set to 1 so DEV_CLOCK_NOW also applies in the production Docker image.
# CADENCE_DEMO=1

# Offline TempoPort: path to a Tempo full-export zip (workouts/splits/time-series/…).
# When set, the API uses the export instead of live Tempo HTTP (no base URL / API key).
# Keep full athlete exports out of git (e.g. under .scratch/). CI tests use the
# committed scrubbed mini pack at api/tests/fixtures/tempo-export-mini.zip instead.
# Example:
# TEMPO_EXPORT_PATH=/absolute/path/to/tempo-export-….zip

# Sign in with Tempo (ADR 0008): the Tempo API address that checks the athlete's username
# and password. Unset = no login. Needs a real DATA_PROTECTION_SECRET_KEY (the API refuses
# the example value above) and HTTPS anywhere but localhost.
# CADENCE_AUTH_TEMPO_URL=http://localhost:5001

# LLM provider for weekly plan (POST /week/reply). Default stub keeps CI offline.
# Set to anthropic for the live BYO-key Anthropic adapter (uses encrypted settings key).
# LLM_PROVIDER=stub
# LLM_PROVIDER=anthropic
# Overall cap per coach call in ms (default 900000 = 15 min; 60 s idle abort is fixed for Anthropic).
# ANTHROPIC_TIMEOUT_MS=900000
# Self-hosted model server: abort after this many ms with no data (default 600000 = 10 min).
# SELF_HOSTED_IDLE_TIMEOUT_MS=600000

# Database connections. How long to wait for one (default 10000 ms), and how long an
# unused one stays open (default 300000 ms = 5 min). Invalid values stop the API at startup.
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=300000

# Athlete timezone (IANA name): one timezone for every route and the UI, so the
# current week, week boundaries and loop status agree. Default UTC. Invalid value
# fails startup.
# ATHLETE_TIMEZONE=America/New_York

# Frontend (Next) -> API proxy timeout in ms (default 960000 = 16 min). Keep it
# above ANTHROPIC_TIMEOUT_MS or the browser sees an error while the API works.
# FRONTEND_PROXY_TIMEOUT_MS=960000

# Code version stamped on every LLM call log row (default: git SHA via npm run dev,
# else CADENCE_GIT_COMMIT, else "dev").
# APP_VERSION=

# Lean live model context (#34): how many prior weeks' recap/plan summaries to
# include alongside the current dossier + current-week thread. Default 4.
# Archived mid-week chatter is never included. Override per-request with
# recentHistoryLimit on POST /packet and POST /week/reply.
# PACKET_RECENT_HISTORY_LIMIT=4

# Dossier audit/trim cadence (#40): weeks between Accept stamps for next due.
# Product window is 4–6 weeks; default 5. Used by POST /dossier/audits and
# ask-in-chat “audit my settings” soft-gate proposals.
# DOSSIER_AUDIT_INTERVAL_WEEKS=5
