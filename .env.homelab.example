# Settings for docker-compose.homelab.yml. Copy to .env.homelab and fill in.
# Keep .env.homelab out of git (it is ignored) and back it up with your database.

# --- Required -------------------------------------------------------------------------

# Password for the Postgres container. It is only used inside the compose network.
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Encrypts the saved Tempo and Anthropic keys in the database. Generate once and keep it:
# if it changes, the saved keys cannot be read and you re-enter them in Settings.
#   openssl rand -base64 32
DATA_PROTECTION_SECRET_KEY=

# Your weeks are stored under this IANA timezone. Set it once and do not change it:
# a different value cannot see the weeks stored under the old one.
ATHLETE_TIMEZONE=America/New_York

# --- Optional -------------------------------------------------------------------------

# Port the web page is published on, and the address it listens on.
# WEB_BIND=127.0.0.1 when a reverse proxy on the same machine is the only way in.
# WEB_PORT=3001
# WEB_BIND=0.0.0.0

# The address you open it at. Only used for the API's cross-origin allow-list.
# PUBLIC_URL=http://homelab.local:3001

# Live coach. "stub" is an offline stand-in that answers with canned text.
# LLM_PROVIDER=anthropic
# ANTHROPIC_MODEL=
# Thinking effort: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=
# Overall cap per coach call in milliseconds (default 900000, 15 minutes).
# ANTHROPIC_TIMEOUT_MS=

# Which published images to run (docker compose pull). latest = main, edge = develop,
# or a commit such as sha-1a2b3c4 to pin one build. Building here with --build tags the
# result the same way, so the same setting names what is running.
# CADENCE_TAG=latest
# CADENCE_REGISTRY=ghcr.io/trevordavies095

# Database connections: how long to wait for one, and how long an unused one stays
# open. The defaults (10 s and 5 min) suit a busy home server; raise the first if pages
# still fail with "connection timeout" while the machine is under load.
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=300000

# Stamped on images built here and on every logged coach call.
# CADENCE_VERSION=
# CADENCE_GIT_COMMIT=
